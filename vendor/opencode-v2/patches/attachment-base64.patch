-export const Base64 = Schema.String.check(
-  Schema.isPattern(/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/u),
-).annotate({ identifier: "Prompt.Base64" })
+// A repeated-group regexp exhausts V8's stack around 4.27 MiB. Scan once
+// without recursion or allocating a second copy of the attachment.
+export function isBase64(value: string): boolean {
+  if (value.length % 4 !== 0) return false
+  let end = value.length
+  if (end && value.charCodeAt(end - 1) === 61) end--
+  if (end && value.charCodeAt(end - 1) === 61) end--
+  for (let index = 0; index < end; index++) {
+    const code = value.charCodeAt(index)
+    if (!((code >= 65 && code <= 90) || (code >= 97 && code <= 122) ||
+      (code >= 48 && code <= 57) || code === 43 || code === 47)) return false
+  }
+  return true
+}
+
+export const Base64 = Schema.String.check(Schema.makeFilter(isBase64)).annotate({ identifier: "Prompt.Base64" })
 export type Base64 = typeof Base64.Type
 
 export interface FileAttachment extends Schema.Schema.Type<typeof FileAttachment> {}
diff --git a/packages/schema/test/prompt-base64.test.ts b/packages/schema/test/prompt-base64.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/schema/test/prompt-base64.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, test } from "bun:test"
+import { Base64, isBase64 } from "../src/prompt.js"
+
+describe("attachment base64 validation", () => {
+  test("accepts empty, padded and unpadded encodings", () => {
+    for (const value of ["", "YQ==", "YWI=", "YWJj", "+/8="]) expect(Base64.make(value)).toBe(value)
+  })
+  test("rejects bad lengths, misplaced padding and invalid characters", () => {
+    for (const value of ["A", "AAA", "====", "A===", "AA=A", "AA\nA", "AA-A", "AA_A", "éAAA"]) {
+      expect(isBase64(value)).toBe(false)
+      expect(() => Base64.make(value)).toThrow()
+    }
+  })
+  test("validates the old crash boundary and the full 20 MiB inline budget", () => {
+    for (const size of [3355434, 3355437, 6 * 1024 * 1024, 20 * 1024 * 1024]) {
+      const value = Buffer.alloc(size, 65).toString("base64")
+      expect(Base64.make(value)).toBe(value)
+      expect(isBase64(value.slice(0, -1) + "!")).toBe(false)
+    }
+  })
+})

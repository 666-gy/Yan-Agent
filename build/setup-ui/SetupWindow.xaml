<!-- Hallmark · native installer · studied: yes · DNA-source: user screenshots
     Yan monochrome / landscape / pill controls · P5 H5 E4 S5 R5 V4 -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yan Agent 安装" Width="800" Height="520" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource Ink}">
  <Window.Resources>
    <SolidColorBrush x:Key="Paper" Color="#141414"/>
    <SolidColorBrush x:Key="Raised" Color="#202020"/>
    <SolidColorBrush x:Key="Hover" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="Pressed" Color="#363636"/>
    <SolidColorBrush x:Key="Rule" Color="#515151"/>
    <SolidColorBrush x:Key="Focus" Color="#ADADAD"/>
    <SolidColorBrush x:Key="Ink" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Muted" Color="#A1A1A1"/>
    <SolidColorBrush x:Key="Inverse" Color="#151515"/>
    <Style TargetType="Button" x:Key="Pill">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rule}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="24,0"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Edge" CornerRadius="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="Opacity" Value="0.84"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Edge" Property="Opacity" Value="0.66"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Focus}"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="Primary" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="{StaticResource Ink}"/><Setter Property="Foreground" Value="{StaticResource Inverse}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button" x:Key="Chrome" BasedOn="{StaticResource Pill}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="18"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="{StaticResource Paper}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/><Setter Property="SelectionBrush" Value="{StaticResource Rule}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rule}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="44"/><Setter Property="Padding" Value="19,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Edge" CornerRadius="22" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Focus}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <StackPanel Orientation="Horizontal" Background="Transparent">
          <Border x:Name="Toggle" Width="44" Height="26" CornerRadius="13" BorderBrush="{StaticResource Rule}" BorderThickness="1" Background="{StaticResource Raised}" Margin="0,0,14,0">
            <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{StaticResource Muted}" HorizontalAlignment="Left" Margin="3,0"/>
          </Border>
          <ContentPresenter VerticalAlignment="Center"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="{StaticResource Ink}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{StaticResource Focus}"/><Setter TargetName="Toggle" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Toggle" Property="Background" Value="{StaticResource Hover}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="TitleArea" Background="Transparent" Margin="20,6,12,0">
        <TextBlock Text="Yan Agent" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="Minimize" Content="−" Style="{StaticResource Chrome}" AutomationProperties.Name="最小化"/>
          <Button x:Name="Close" Content="×" Style="{StaticResource Chrome}" AutomationProperties.Name="关闭"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="64,0,64,32">
        <StackPanel x:Name="Brand" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,35,0,0">
          <Image x:Name="Logo" Width="104" Height="104" Stretch="Uniform"/>
          <TextBlock Text="Yan Agent" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="30" HorizontalAlignment="Center" Margin="0,15,0,0"/>
          <TextBlock x:Name="Version" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel x:Name="Welcome" VerticalAlignment="Bottom">
          <TextBlock Text="安装位置" Foreground="{StaticResource Muted}" FontSize="12" Margin="18,0,0,9"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
            <TextBox x:Name="InstallDirectory" AutomationProperties.Name="安装目录"/>
            <Button x:Name="Browse" Grid.Column="2" Content="选择" Style="{StaticResource Pill}"/>
          </Grid>
          <TextBlock x:Name="DirectoryError" Foreground="{StaticResource Ink}" FontSize="12" Margin="18,7,0,0" TextWrapping="Wrap" MinHeight="17"/>
          <Button x:Name="Continue" Content="继续" Width="148" Style="{StaticResource Primary}" Margin="0,12,0,0"/>
        </StackPanel>
        <Grid x:Name="PathPage" Visibility="Collapsed" VerticalAlignment="Bottom">
          <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="22,0,22,26">
            <CheckBox x:Name="AddToPath" Content="加入 PATH" IsChecked="True" FontSize="16"/>
            <TextBlock Text="让 IDE 和终端能够找到 Yan Agent。" Foreground="{StaticResource Muted}" Margin="58,12,0,0"/>
            <TextBlock Text="同时更新用户与系统 PATH，重新打开终端后生效。" Foreground="{StaticResource Muted}" FontSize="12" Margin="58,6,0,0"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="Back" Content="上一步" Width="124" Style="{StaticResource Pill}" Margin="0,0,12,0"/>
            <Button x:Name="Install" Content="立即安装" Width="148" Style="{StaticResource Primary}"/>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="0,0,0,28">
          <Border Height="6" CornerRadius="3" Background="{StaticResource Rule}" ClipToBounds="True">
            <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource Ink}"/>
          </Border>
          <TextBlock x:Name="ProgressLabel" Text="正在准备安装…" HorizontalAlignment="Center" Margin="0,22,0,0"/>
          <TextBlock Text="请稍候，安装完成后即可开始使用。" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel x:Name="FinishPage" Visibility="Collapsed" VerticalAlignment="Bottom">
          <TextBlock x:Name="FinishTitle" Text="安装完成" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="FinishCopy" Text="Yan Agent 已准备就绪。" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,22" TextWrapping="Wrap" MaxWidth="580"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="FinishClose" Content="完成" Width="124" Style="{StaticResource Pill}" Margin="0,0,12,0"/>
            <Button x:Name="Launch" Content="启动 Yan Agent" Style="{StaticResource Primary}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>

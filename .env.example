# Yan Agent environment variables

# ---------------------------------------------------------------------------
# nuphus-mcp bridge configuration
# ---------------------------------------------------------------------------
# Optional: override the command used to launch the nuphus-mcp stdio server.
# If unset, Yan Agent will use the locally installed @nuphus/nuphus-mcp
# package (node_modules/@nuphus/nuphus-mcp/bin/cli.js).
#
# Examples:
#   NUPHUS_MCP_COMMAND=nuphus-mcp
#   NUPHUS_MCP_ARGS=--confirm-write
#
#   NUPHUS_MCP_COMMAND=C:\path\to\nuphus-mcp.exe
#   NUPHUS_MCP_ARGS=
#
NUPHUS_MCP_COMMAND=
NUPHUS_MCP_ARGS=

# ---------------------------------------------------------------------------
# nuphus-mcp vision provider (optional, only used when calling vision tools)
# ---------------------------------------------------------------------------
# NUPHUS_MCP_VISION_API_KEY=sk-...
# NUPHUS_MCP_VISION_BASE_URL=https://api.openai.com/v1
# NUPHUS_MCP_VISION_MODEL=gpt-4o-mini
# NUPHUS_MCP_VISION_PROVIDER=auto
# NUPHUS_MCP_VISION_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# nuphus-mcp browser / perceive configuration (optional)
# ---------------------------------------------------------------------------
# NUPHUS_MCP_BROWSER_CDP_URL=http://127.0.0.1:9222
# NUPHUS_BROWSER_EXE_PATH=C:\path\to\browser.exe
# NUPHUS_BROWSER_NAME=指纹浏览器
# NUPHUS_BROWSER_USER_DATA_DIR=C:\path\to\profile
# NUPHUS_MODELS_DIR=C:\path\to\models
# NUPHUS_MCP_NO_MODEL_DOWNLOAD=1
